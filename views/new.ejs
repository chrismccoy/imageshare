<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('partials/_head') %>
    <title>Image Share</title>
    <meta name="csrf-token" content="<%= csrfToken %>" />
  </head>
  <body class="bg-surface-50 text-surface-700 min-h-screen flex items-center justify-center p-4 antialiased">
    <div class="w-full max-w-2xl">

      <div class="text-center mb-10">
        <div class="inline-flex items-center gap-3 mb-4">
          <div class="w-11 h-11 rounded-xl bg-brand-600 flex items-center justify-center shadow-lg shadow-brand-600/20">
            <svg class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 15.75 5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909M18 9.75h.008v.008H18V9.75ZM3.75 20.25h16.5A1.5 1.5 0 0 0 21.75 18.75V5.25a1.5 1.5 0 0 0-1.5-1.5H3.75a1.5 1.5 0 0 0-1.5 1.5v13.5a1.5 1.5 0 0 0 1.5 1.5Z" />
            </svg>
          </div>
          <h1 class="text-3xl font-bold text-surface-800 tracking-tight">Image Share</h1>
        </div>
        <p class="text-surface-400 text-sm">
          Share a <span class="text-brand-500 font-medium">screenshot</span> in one link
        </p>
      </div>

      <form id="form" data-max-bytes="<%= maxBytes %>">
        <input id="file-input" type="file" accept="image/png,image/jpeg,image/gif" hidden />

        <div class="bg-white border border-surface-200 rounded-2xl overflow-hidden shadow-xl shadow-surface-200/50">

          <div class="flex border-b border-surface-100">
            <button
              type="button"
              class="tab flex-1 py-3.5 text-sm font-semibold transition-all border-b-2 cursor-pointer border-brand-500 text-brand-600 bg-brand-50/50"
              data-panel="upload"
            >
              Upload File
            </button>
            <button
              type="button"
              class="tab flex-1 py-3.5 text-sm font-semibold transition-all border-b-2 cursor-pointer border-transparent text-surface-400 hover:text-surface-500 hover:bg-surface-50"
              data-panel="clipboard"
            >
              Paste from Clipboard
            </button>
          </div>

          <div class="panel" id="panel-upload">
            <div class="p-6">
              <div
                id="dropzone"
                class="border-2 border-dashed rounded-xl p-14 text-center transition-all cursor-pointer border-surface-200 hover:border-brand-300 hover:bg-brand-50/30"
              >
                <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-brand-50 mb-5">
                  <svg class="w-8 h-8 text-brand-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5m-13.5-9L12 3m0 0 4.5 4.5M12 3v13.5" />
                  </svg>
                </div>
                <h2 class="text-base font-semibold text-surface-700 mb-1">
                  Drop your image here
                </h2>
                <p class="text-xs text-surface-400">
                  PNG, JPEG or GIF — or click to browse
                </p>
              </div>
            </div>
            <div class="px-6 pb-6 flex gap-3 justify-end">
              <button
                type="button"
                id="browse-btn"
                class="px-5 py-2.5 text-sm font-medium rounded-lg transition-all cursor-pointer bg-white text-surface-600 border border-surface-200 hover:bg-surface-50 hover:border-surface-300 shadow-sm"
              >
                Browse
              </button>
              <button
                type="button"
                id="submit-btn"
                disabled
                class="px-6 py-2.5 text-sm font-semibold rounded-lg transition-all cursor-pointer bg-brand-600 text-white hover:bg-brand-700 shadow-sm shadow-brand-600/20 disabled:opacity-40 disabled:cursor-not-allowed disabled:shadow-none"
              >
                Upload
              </button>
            </div>
          </div>

          <div class="panel hidden" id="panel-clipboard">
            <div class="p-6">
              <div
                id="paste-target"
                tabindex="0"
                class="border-2 border-dashed border-surface-200 rounded-xl p-14 text-center outline-none focus:border-brand-300 focus:bg-brand-50/30 transition-all"
              >
                <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-brand-50 mb-5">
                  <svg class="w-8 h-8 text-brand-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.666 3.888A2.25 2.25 0 0 0 13.5 2.25h-3c-1.03 0-1.9.693-2.166 1.638m7.332 0c.055.194.084.4.084.612v0a.75.75 0 0 1-.75.75H9a.75.75 0 0 1-.75-.75v0c0-.212.03-.418.084-.612m7.332 0c.646.049 1.288.11 1.927.184 1.1.128 1.907 1.077 1.907 2.185V19.5a2.25 2.25 0 0 1-2.25 2.25H6.75A2.25 2.25 0 0 1 4.5 19.5V6.257c0-1.108.806-2.057 1.907-2.185a48.208 48.208 0 0 1 1.927-.184" />
                  </svg>
                </div>
                <h2 class="text-base font-semibold text-surface-700 mb-1">
                  Press <kbd class="px-1.5 py-0.5 rounded bg-surface-100 border border-surface-200 font-mono text-xs">Ctrl</kbd>
                  +
                  <kbd class="px-1.5 py-0.5 rounded bg-surface-100 border border-surface-200 font-mono text-xs">V</kbd>
                </h2>
                <p class="text-xs text-surface-400">
                  Take a screenshot, then paste it straight in
                </p>
              </div>
            </div>
          </div>

          <div id="status" class="px-6 pb-6 hidden">
            <div id="preview-wrap" class="hidden mb-4 flex items-center gap-3">
              <img id="preview" alt="" class="h-16 w-24 object-cover rounded border border-surface-200 bg-surface-50" />
              <span id="file-name" class="text-sm font-medium text-emerald-600 break-all"></span>
            </div>
            <div id="progress-wrap" class="hidden h-1.5 rounded-full bg-surface-100 overflow-hidden">
              <div id="progress" class="h-full w-0 bg-brand-500 transition-all"></div>
            </div>
            <div id="error" class="mt-3 text-sm text-red-500 hidden"></div>
          </div>

        </div>
      </form>

      <p class="text-center mt-8 text-xs text-surface-300">
        Images expire after <%= expiryYears %> year<%= expiryYears !== 1 ? "s" : "" %>.
        Location and camera metadata are stripped on upload.
      </p>

    </div>

    <script src="/js/app.js"></script>
  </body>
</html>
